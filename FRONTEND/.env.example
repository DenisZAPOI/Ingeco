# Copy this file to ".env".
# Every variable prefixed with VITE_ is visible in the browser:
# NEVER put a secret here.

# Back-end API address. Also used by the real-time channel.
VITE_API_URL=http://localhost:5000

# Call-center number shown on the welcome screen, in international format
# (+594…). Leave empty until the client gives it: the block stays hidden.
VITE_CALL_CENTER_PHONE=
