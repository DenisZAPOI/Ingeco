# -----------------------------------------------------------------------------
#  Base de données locale (compose.yaml). COPIER ce fichier en ".env".
#  Le fichier .env n'est JAMAIS commité.
# -----------------------------------------------------------------------------

# Mots de passe de la base locale. Générer chacun avec :
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_ROOT_PASSWORD=replace-with-a-generated-password
MYSQL_PASSWORD=replace-with-a-generated-password

MYSQL_DATABASE=enroute
MYSQL_USER=enroute

# 3307 plutôt que 3306 : beaucoup de postes ont déjà un MySQL (WAMP, XAMPP) sur 3306
MYSQL_PORT=3307
