# -----------------------------------------------------------------------------
#  Configuration template: COPY this file to ".env" and adapt it.
#  The .env file is NEVER committed: it holds secrets.
# -----------------------------------------------------------------------------

# Database connection: the local MySQL container (compose.yaml at the repo
# root). User, password, port and database name are those of the root .env
# file (MYSQL_USER, MYSQL_PASSWORD, MYSQL_PORT, MYSQL_DATABASE).
DATABASE_URL=mysql+pymysql://enroute:replace-with-MYSQL_PASSWORD@127.0.0.1:3307/enroute?charset=utf8mb4

# Signing key (session cookies and JWT). 32 characters minimum. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-generated-key

# Origins allowed to call the API and the WebSocket, comma separated.
# 5173 is the port of the front-end dev server.
CORS_ORIGINS=http://localhost:5173

# Flask debug mode: "true" in development only.
FLASK_DEBUG=true

# Logging: level (DEBUG, INFO, WARNING, ERROR) and format (json, text).
LOG_LEVEL=INFO
LOG_FORMAT=text

# API port
PORT=5000

# Session cookies sent over HTTPS only. "false" in local development (http),
# ALWAYS "true" once deployed.
COOKIE_SECURE=false
