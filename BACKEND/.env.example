# -----------------------------------------------------------------------------
#  Configuration template: COPY this file to ".env" and adapt it.
#  The .env file is NEVER committed: it holds secrets.
# -----------------------------------------------------------------------------

# Database connection: the local MySQL container (compose.yaml at the repo
# root). User, password, port and database name are those of the root .env
# file (MYSQL_USER, MYSQL_PASSWORD, MYSQL_PORT, MYSQL_DATABASE).
DATABASE_URL=mysql+pymysql://enroute:replace-with-MYSQL_PASSWORD@127.0.0.1:3307/enroute?charset=utf8mb4

# Signing key (session cookies and JWT). 32 characters minimum, the API
# refuses to start otherwise. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-generated-key

# Origins allowed to call the API and the WebSocket, comma separated.
# 5173 is the port of the front-end dev server.
CORS_ORIGINS=http://localhost:5173

# Flask debug mode: "true" in development only (refused with COOKIE_SECURE=true).
FLASK_DEBUG=true

# Logging: level (DEBUG, INFO, WARNING, ERROR) and format (json, text).
LOG_LEVEL=INFO
LOG_FORMAT=text

# API port
PORT=5000

# Session cookies sent over HTTPS only. "false" in local development (http),
# ALWAYS "true" once deployed.
COOKIE_SECURE=false

# OpenRouteService key (address search and road distance), free account on
# https://openrouteservice.org. Empty: fake places and distances, no call to
# the Internet.
ORS_API_KEY=

# Expiry of the rides left without a driver, every minute (UC60). Leave
# "true"; the tests set it to "false" and run the task themselves.
PERIODIC_TASKS_ENABLED=true

# Test accounts of the README (part "Comptes de test"), whose password is
# PUBLIC, an administrator among them. "true" in local development only: the
# API refuses to start with it when COOKIE_SECURE=true. Absent: "false".
LOAD_DEMO_DATA=true

# Swagger (/apidoc/swagger) and the OpenAPI schema used by "npm run api:types".
# "true" in development; absent or "false" once deployed: /apidoc answers 404.
API_DOCS_ENABLED=true

# Reverse proxies in front of the API (nginx, a hosting platform), whose
# X-Forwarded-For header gives the client address used by the limits per
# address. 0 in local development; set it once the hosting is chosen.
TRUSTED_PROXY_COUNT=0
