# -----------------------------------------------------------------------------
#  Configuration template: COPY this file to ".env" and adapt it.
#  The .env file is NEVER committed: it holds secrets.
# -----------------------------------------------------------------------------

# Database connection. Until the DB team delivers the schema, a local SQLite
# file is enough (it is created on first connection, and stays empty).
DATABASE_URL=sqlite:///local.db

# Signing key (sessions, and JWT later on). 32 characters minimum. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-generated-key

# Origins allowed to call the API and the WebSocket, comma separated.
# 5173 is the port of the front-end dev server.
CORS_ORIGINS=http://localhost:5173

# Flask debug mode: "true" in development only.
FLASK_DEBUG=true

# Logging: level (DEBUG, INFO, WARNING, ERROR) and format (json, text).
LOG_LEVEL=INFO
LOG_FORMAT=text

# API port
PORT=5000
